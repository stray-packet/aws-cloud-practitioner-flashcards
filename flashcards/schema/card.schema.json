{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stray-packet.github.io/aws-cloud-practitioner-flashcards/schema/card.schema.json",
  "title": "AWS Study Flashcard",
  "type": "object",
  "required": ["id", "certification", "studyDate", "domain", "topics", "services", "type", "prompt", "answer", "explanation", "sourceRef", "difficulty", "status", "version"],
  "properties": {
    "id": { "type": "string", "pattern": "^clf-c02-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$" },
    "certification": { "const": "CLF-C02" },
    "studyDate": { "type": "string", "format": "date" },
    "domain": { "enum": ["Cloud Concepts", "Security and Compliance", "Cloud Technology and Services", "Billing, Pricing, and Support"] },
    "topics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "services": { "type": "array", "items": { "type": "string" } },
    "type": { "enum": ["recall", "scenario", "comparison", "cloze", "single-choice", "multiple-response"] },
    "prompt": { "type": "string", "minLength": 8 },
    "answer": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 8 },
    "examCue": { "type": "string" },
    "options": { "type": "array", "items": { "type": "object", "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string" } } } },
    "correctOptions": { "type": "array", "items": { "type": "string" } },
    "sourceRef": { "type": "string" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "status": { "enum": ["draft", "approved"] },
    "version": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
